# syntax=docker/dockerfile:1

# ── Stage 1: install ──────────────────────────────────────────────────────────
FROM python:3.13-slim AS install

COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /app

# Third-party deps only — no --no-install-project needed since we never install
# the local "rec" project into the venv (main.py is run directly by path, not
# via the [project.scripts] console entry point). Keeping this a deps-only
# layer means it — and everything built on top of it, including the Chromium
# download below — only busts when pyproject.toml/uv.lock change, not on every
# source-code commit. No --mount=type=ssh needed — azkees/pylogpy/playwright
# all resolve from PyPI, unlike fin/finapi/nordlink's private git+ssh deps.
RUN --mount=type=bind,source=pyproject.toml,target=pyproject.toml \
    --mount=type=bind,source=uv.lock,target=uv.lock \
    --mount=type=cache,target=/root/.cache/uv \
    uv sync --frozen --no-install-project --no-dev


# ── Stage 2: runtime ─────────────────────────────────────────────────────────
FROM python:3.13-slim AS runtime

ENV VIRTUAL_ENV=/app/.venv \
    PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PLAYWRIGHT_BROWSERS_PATH=/app/.cache/ms-playwright

WORKDIR /app

COPY --from=install /app/.venv /app/.venv

# Chromium + its OS-level deps (libnss3, libatk, etc.). This layer is cached
# based on the deps-only venv above, so it's only re-downloaded when the
# Playwright version itself changes — source is copied in *after* this step,
# so editing rec/*.py never busts the Chromium download.
RUN /app/.venv/bin/playwright install --with-deps chromium

COPY main.py .
COPY rec/ ./rec/

RUN mkdir -p /app/state

# Runs as root, matching finapi/fin (the actual templates for this service) —
# not nordlink's non-root pattern, which breaks writes to a host-bind-mounted
# /app/state volume whenever the host directory's uid doesn't happen to be 1000.

# No HTTP server (background poller) — health is a heartbeat file touched
# once per poll cycle, checked against 2x the configured poll interval.
HEALTHCHECK --interval=60s --timeout=10s --start-period=45s --retries=3 \
    CMD ["/app/.venv/bin/python", "-c", "import os,sys,time; p='/app/state/heartbeat'; sys.exit(0 if os.path.exists(p) and time.time()-os.path.getmtime(p) < 2*int(os.environ.get('poll_seconds','300')) else 1)"]

CMD ["/app/.venv/bin/python", "main.py"]
