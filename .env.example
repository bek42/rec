# --- azkees config file location (mounted from host in prod) ---
keys_config_linux=/app/api_keys.ini
keys_config_windows=C:\path\to\api_keys.ini

# --- Infisical section + secret-name indirection for Gmail credentials ---
# Reuses the existing "az-keyvault-smtp" section in api_keys.ini (same one
# pylogpy/nordlink-1 already use) instead of provisioning a new machine
# identity. key_gmail_username / key_gmail_app_password are SECRET NAMES in
# Infisical (the existing smtp-username / smtp-pwd secrets), not values.
key_gmail_infisical_section=az-keyvault-smtp
key_gmail_username=smtp-username
key_gmail_app_password=smtp-pwd

# --- Non-secret application config ---
# gmail_label_in is watched for new receipts; once forwarded, the message is
# moved (via Gmail's IMAP label extension) from gmail_label_in to
# gmail_label_out, so processed mail is visibly separated in Gmail itself.
gmail_label_in=rec/in
gmail_label_out=rec/out
dest_email=bharani.nitturi@bain.com
poll_seconds=300
test_mode=false
dedup_state_path=/app/state/dedup_state.json
LOG_FOLDER_linux=/var/log/rec/
TZ=Europe/London

# --- Optional HTTP upload channel (see rec/http_server.py) ---
# Off by default. When http_enabled=true, rec also serves an authenticated
# "POST /upload" endpoint that accepts a receipt photo (raw image body or
# multipart/form-data) and forwards it through the same pipeline as email.
# Publish the port from the host, e.g.:  tailscale funnel --bg --https=443 http://127.0.0.1:8080
http_enabled=false
http_bind=0.0.0.0
http_port=8080
http_max_upload_bytes=26214400
http_result_timeout=60
# Bearer token, resolved via Infisical like the Gmail creds. key_http_token is
# a SECRET NAME; key_http_infisical_section defaults to the Gmail section.
key_http_infisical_section=az-keyvault-smtp
key_http_token=rec-http-token

# --- OCR (Tesseract) + PDF text -> output filename ---
# When ocr_enabled=true, receipt images are run through Tesseract and PDF
# attachments have their text layer read; the output PDF is then named
# vendor-category-CUR-amount-id.pdf (a non-GBP amount is preferred over GBP).
# Any OCR/parse failure falls back to the sender slug + subject/body regex.
# ocr_langs is '+'-joined; needs the matching tesseract-ocr-<lang> packages.
ocr_enabled=true
ocr_langs=eng+deu
# tesseract_cmd=            # absolute path to the binary; empty = use PATH
ocr_timeout=30
